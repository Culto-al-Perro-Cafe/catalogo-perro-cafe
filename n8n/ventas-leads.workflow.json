    {
      "parameters": {
        "jsCode": "// One lead per request from the Catálogo B2B \"Platica con ventas\" form.\n// The site validates on its server before posting, so this only shapes a\n// clean record with Spanish field names for whatever runs next.\nconst body = $input.first().json.body || {};\nconst s = (v) => String(v ?? '').trim();\n\nconst tipo = s(body.tipo) === 'Otro' && s(body.tipoOtro)\n  ? `Otro: ${s(body.tipoOtro)}`\n  : s(body.tipo);\n\nreturn [{\n  json: {\n    nombre: s(body.nombre),\n    email: s(body.email),\n    whatsapp: s(body.whatsapp),\n    codigoPostal: s(body.cp),\n    consumoMensual: s(body.consumo),\n    lineaDeInteres: s(body.linea),\n    tipoDeEstablecimiento: tipo,\n    enviadoEn: s(body.submittedAt) || new Date().toISOString(),\n    origen: 'catalogo-b2b',\n  },\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
