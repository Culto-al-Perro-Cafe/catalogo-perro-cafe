# Public URL of the deployed site (no trailing slash). Used for canonical URLs,
# Open Graph, sitemap.xml, robots.txt and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.perro.cafe

# Where "Solicita cotización" leads are POSTed as JSON (Zapier, Make, n8n, CRM…).
